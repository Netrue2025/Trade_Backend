PORT=3000
APP_SECRET=change-this-before-production
ADMIN_EMAIL=admin@trade.local
ADMIN_PASSWORD=Admin123!
# Keep disabled unless you explicitly want public admin self-signup.
# ADMIN_SELF_SIGNUP_ENABLED=false
# Required when the frontend is deployed on a separate domain.
FRONTEND_ORIGIN=https://netruefi.org,https://www.netruefi.org
FRONTEND_URL=https://netruefi.org
# Railway exposes this automatically after Public Networking is enabled.
# You can leave BACKEND_URL blank on Railway if RAILWAY_PUBLIC_DOMAIN exists.
BACKEND_URL=https://your-backend.up.railway.app

# Paystack transfers. Use TEST keys first; never expose PAYSTACK_SECRET_KEY to frontend code.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
TELEGRAM_ADMIN_CHAT_ID=

# Web Push / PWA notifications. Generate keys with:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@netruefi.org

# Required before saving VTU.ng credentials in admin settings.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=

# MongoDB app-state storage for production.
# Railway MongoDB may expose MONGO_URL or DATABASE_URL; copy that value into
# MONGODB_URI or leave the provided Railway variable name in place.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/trade_mvp?appName=Cluster0
# MONGODB_DB_NAME=trade_mvp
# MONGODB_COLLECTION=app_state

# Referral program defaults. Admin settings can update these from the dashboard.
# REFERRAL_BONUS_NGN=500
# REFERRAL_MIN_DEPOSIT_NGN=2000
# REFERRAL_MIN_SPEND_NGN=2000
# REFERRAL_MIN_TRADES=2
# REFERRAL_MAX_EARNINGS_NGN=100000
# REFERRAL_CAMPAIGN_MAXIMUM_NGN=100000

# Optional Telegram subscriber storage override. Falls back to MONGODB_URI when omitted.
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/trade_mvp

# Optional Bybit endpoints and fiat fallback.
# BYBIT_BASE_URL=https://api.bybit.com
# BYBIT_TESTNET_URL=https://api-testnet.bybit.com
# BYBIT_USDT_NGN_RATE=1500
# Optional Binance endpoints.
# BINANCE_BASE_URL=https://api.binance.com
# BINANCE_TESTNET_URL=https://testnet.binance.vision
# BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# BINANCE_FUTURES_TESTNET_URL=https://testnet.binancefuture.com
# BINANCE_FUTURES_ACCOUNT_CACHE_TTL_MS=180000
# BINANCE_FUTURES_RATE_LIMIT_BACKOFF_MS=300000

# Platform and wallet settings.
# PLATFORM_NAME=NetrueFX
# SUPPORT_EMAIL=support@example.com
# USDT_NGN_RATE=1600
# DEPOSIT_USDT_ADDRESS=TXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEPOSIT_USDT_NETWORK=TRC20
# MIN_DEPOSIT_USDT=1
# MAX_DEPOSIT_USDT=1000000
# MIN_WITHDRAWAL_USDT=50
# MAX_WITHDRAWAL_USDT=1000000
# MIN_WITHDRAWAL_NGN=500
# MAX_WITHDRAWAL_NGN=1000000000
# MAX_DAILY_WITHDRAWAL_NGN=10000000
# WITHDRAWAL_USDT_FEE=0
# WITHDRAWAL_NGN_FEE=100
# MIN_TRADE_JOIN_USDT=1

# VTU.ng is configured from Admin Settings > Airtime & Data.
# Add this webhook URL in your VTU.ng dashboard after deployment:
# https://your-backend.up.railway.app/api/webhooks/vtu

# Akunding Digital Services reseller API.
# Keep AKUNDING_API_KEY only on the backend host, never in frontend config.
# Use mock mode only for local development/testing; keep it false in production.
# AKUNDING_API_KEY=
# AKUNDING_BASE_URL=https://akunding.shop
# AKUNDING_GLOBAL_MARKUP_PERCENT=20
# AKUNDING_TIMEOUT_MS=25000
# AKUNDING_MOCK_MODE=false

# Signal engine and bot settings.
# SIGNAL_TIMEFRAME=15m
# SIGNAL_INGEST_SECRET=change-me
# SIGNAL_ENGINE_BACKEND_URL=https://your-backend.example.com
# SIGNAL_ENGINE_INGEST_PATH=/api/signals
# SIGNAL_ENGINE_TIMEFRAMES=15m,1h,1d
# SIGNAL_ENGINE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# SIGNAL_ENGINE_INTERVAL_MS=45000
# SIGNAL_ENGINE_HISTORY_LIMIT=240
# SIGNAL_ENGINE_MIN_CONFIDENCE=0.6
# SIGNAL_ENGINE_COOLDOWN_MS=900000
# SIGNAL_ENGINE_MARKET_TIMEOUT_MS=30000
# SIGNAL_ENGINE_POST_TIMEOUT_MS=15000
# SIGNAL_ENGINE_PROVIDER_RETRIES=2
# SIGNAL_ENGINE_BATCH_PAUSE_MS=350
# SIGNAL_ENGINE_MAX_CONCURRENCY=2
# SIGNAL_ENGINE_EXCHANGE=bybit
# SIGNAL_ENGINE_ENABLE_SOUND=true

# Telegram bot settings.
# TELEGRAM_BOT_TOKEN=123456789:shared_bot_token
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_SIGNAL_BOT_TOKEN=123456789:signal_bot_token
# TELEGRAM_SIGNAL_CHAT_ID=123456789
# TELEGRAM_TRADE_BOT_TOKEN=123456789:trade_bot_token
# TELEGRAM_SIGNAL_CHANNEL=netruesignal
# For private channels, use the numeric channel ID instead.
# TELEGRAM_CHANNEL_CHAT_ID=-1001234567890
# TELEGRAM_TRADE_BOT_POLLING_ENABLED=false
