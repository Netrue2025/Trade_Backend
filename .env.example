PORT=3000
APP_SECRET=change-this-before-production
ADMIN_EMAIL=admin@trade.local
ADMIN_PASSWORD=Admin123!
# Keep disabled unless you explicitly want public admin self-signup.
# ADMIN_SELF_SIGNUP_ENABLED=false
# Required when the frontend is deployed on a separate domain.
FRONTEND_ORIGIN=https://trade-frontend-jwu2.onrender.com

# MongoDB app-state storage for production.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/trade_mvp?appName=Cluster0
# MONGODB_DB_NAME=trade_mvp
# MONGODB_COLLECTION=app_state

# Optional Telegram subscriber storage override. Falls back to MONGODB_URI when omitted.
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/trade_mvp

# Optional Bybit endpoints and fiat fallback.
# BYBIT_BASE_URL=https://api.bybit.com
# BYBIT_TESTNET_URL=https://api-testnet.bybit.com
# BYBIT_USDT_NGN_RATE=1500
# Optional Binance endpoints.
# BINANCE_BASE_URL=https://api.binance.com
# BINANCE_TESTNET_URL=https://testnet.binance.vision
# BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# BINANCE_FUTURES_TESTNET_URL=https://testnet.binancefuture.com

# Platform and wallet settings.
# PLATFORM_NAME=NetrueFX
# SUPPORT_EMAIL=support@example.com
# USDT_NGN_RATE=1600
# DEPOSIT_USDT_ADDRESS=TXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEPOSIT_USDT_NETWORK=TRC20
# MIN_DEPOSIT_USDT=1
# MAX_DEPOSIT_USDT=1000000
# MIN_WITHDRAWAL_USDT=1
# MAX_WITHDRAWAL_USDT=1000000
# MIN_WITHDRAWAL_NGN=1000
# MAX_WITHDRAWAL_NGN=1000000000
# MAX_DAILY_WITHDRAWALS=2
# WITHDRAWAL_USDT_FEE=0
# WITHDRAWAL_NGN_FEE=0

# Signal engine and bot settings.
# SIGNAL_TIMEFRAME=15m
# SIGNAL_INGEST_SECRET=change-me
# SIGNAL_ENGINE_BACKEND_URL=https://your-backend.example.com
# SIGNAL_ENGINE_INGEST_PATH=/api/signals
# SIGNAL_ENGINE_TIMEFRAMES=15m,1h,1d
# SIGNAL_ENGINE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# SIGNAL_ENGINE_INTERVAL_MS=45000
# SIGNAL_ENGINE_HISTORY_LIMIT=240
# SIGNAL_ENGINE_MIN_CONFIDENCE=0.6
# SIGNAL_ENGINE_COOLDOWN_MS=900000
# SIGNAL_ENGINE_MARKET_TIMEOUT_MS=30000
# SIGNAL_ENGINE_POST_TIMEOUT_MS=15000
# SIGNAL_ENGINE_PROVIDER_RETRIES=2
# SIGNAL_ENGINE_BATCH_PAUSE_MS=350
# SIGNAL_ENGINE_MAX_CONCURRENCY=2
# SIGNAL_ENGINE_EXCHANGE=bybit
# SIGNAL_ENGINE_ENABLE_SOUND=true

# Telegram bot settings.
# TELEGRAM_BOT_TOKEN=123456789:shared_bot_token
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_SIGNAL_BOT_TOKEN=123456789:signal_bot_token
# TELEGRAM_SIGNAL_CHAT_ID=123456789
# TELEGRAM_TRADE_BOT_TOKEN=123456789:trade_bot_token
# TELEGRAM_TRADE_BOT_POLLING_ENABLED=false
